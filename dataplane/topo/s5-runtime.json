{
  "target": "bmv2",
  "p4info": "build/switch.p4.p4info.txt",
  "bmv2_json": "build/switch.json",
  "table_entries": [
    {
      "table": "MyEgress.swtrace",
      "default_action": true,
      "action_name": "MyEgress.add_swtrace",
      "action_params": {
         "swid": 5
       }
    },
    {
      "table": "MyIngress.ipv4_lpm",
      "match": {
        "hdr.ipv4.dstAddr": ["10.0.1.0", 24]
      },
      "action_name": "MyIngress.set_nhop",
      "action_params": {
        "dstAddr": "08:00:00:00:01:11",
        "port": 1
      }
    },

    {
      "table": "MyIngress.ipv4_lpm",
      "match": {
        "hdr.ipv4.dstAddr": ["10.0.2.0", 24]
      },
      "action_name": "MyIngress.set_nhop",
      "action_params": {
        "dstAddr": "08:00:00:00:03:33",
        "port": 3
      }
    },
    
    {
      "table": "MyIngress.ipv4_lpm",
      "match": {
        "hdr.ipv4.dstAddr": ["10.0.3.0", 24]
      },
      "action_name": "MyIngress.set_nhop",
      "action_params": {
        "dstAddr": "08:00:00:00:04:44",
        "port": 1
      }
    },

    {
      "table": "MyIngress.ipv4_lpm",
      "match": {
        "hdr.ipv4.dstAddr": ["10.6.0.0", 16]
      },
      "action_name": "MyIngress.set_nhop",
      "action_params": {
        "dstAddr": "08:00:00:00:02:22",
        "port": 2
      }
    }
  ]
}
